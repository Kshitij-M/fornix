# Local-only development values. Copy to .env; do not commit .env.
FORNIX_DB_NAME=fornix
FORNIX_DB_USER=fornix
FORNIX_DB_PASSWORD=fornix-dev-only
FORNIX_PG_PORT=55433

# Canonical Fornix runtime configuration.
# Development compatibility is intentionally explicit. Production should use
# FORNIX_AUTH_MODE=workspace and provision identities/API keys through the
# typed AuthStore or a future administrative CLI.
FORNIX_AUTH_MODE=development
# Starts the agent scheduler and the generic read/observation operation worker.
# Effectful operations remain behind their durable dispatcher and authority.
FORNIX_WORKER_ENABLED=true
FORNIX_OPERATION_WORKER_MAX_CONCURRENT=4
FORNIX_OPERATION_WORKER_CLAIM_BATCH=8
FORNIX_OPERATION_WORKER_MAX_ACTIVE=4
FORNIX_OPERATION_WORKER_POLL_INTERVAL_SECONDS=2
# Historical federation/router compatibility APIs are disabled by default
# because their original tables predate workspace isolation. Only enable this
# in a controlled migration environment, never in production.
FORNIX_ENABLE_LEGACY_GLOBAL_SURFACES=false
# Require signed, durable trust and schema catalogs before serving a
# workspace. Production enables this automatically; set true locally to
# rehearse the fail-closed authority rollout.
FORNIX_REQUIRE_SIGNED_AUTHORITY=false
# Require a durable, workspace-scoped qualification trust snapshot before
# readiness and authorized evidence imports. Production enables this.
FORNIX_REQUIRE_QUALIFICATION_TRUST=false
# Required when FORNIX_REQUIRE_QUALIFICATION_TRUST=true.
# FORNIX_QUALIFICATION_DEPLOYMENT_ID=local-development
# Require a verified release/gate/artifact binding before readiness. Production
# enables this automatically and requires the explicit release identity.
FORNIX_REQUIRE_QUALIFICATION_RELEASE=false
# Required when FORNIX_REQUIRE_QUALIFICATION_RELEASE=true.
# FORNIX_QUALIFICATION_RELEASE_ID=release-local
# FORNIX_QUALIFICATION_RELEASE_ARTIFACT_KIND=release
# Require every new generic external-effect reservation to carry a current,
# hash-only deployment admission reference. Production enables this by default.
FORNIX_REQUIRE_RELEASE_ADMISSION_FOR_EFFECTS=false
FORNIX_KEY=fornix-dev-only-change-me
# Required only for workspace bootstrap when using the operator CLI/API.
# Keep this in .env or the process environment; never commit or print it.
FORNIX_BOOTSTRAP_KEY=replace-with-a-local-bootstrap-secret
FORNIX_WORKSPACE_ID=default
FORNIX_PG_DSN=postgres://fornix:fornix-dev-only@localhost:55433/fornix?sslmode=disable
FORNIX_LISTEN=:8201
FORNIX_OLLAMA_URL=http://localhost:11434

# Optional remote chat provider. Disabled unless explicitly enabled. The
# credential value is supplied only in the local .env/environment and is
# never committed or placed in a model request.
FORNIX_OPENAI_ENABLED=false
# FORNIX_OPENAI_API_KEY=
# Development only: this is an environment-variable name by default. For a
# managed secret, set a namespaced reference (for example openai/service-key)
# and configure the credential manager below. Production always requires the
# managed-reference form and never reads FORNIX_OPENAI_API_KEY.
# FORNIX_OPENAI_CREDENTIAL_REF=openai/service-key
# FORNIX_OPENAI_BASE_URL=https://api.openai.com/v1
# FORNIX_OPENAI_MODEL=gpt-4o-mini
# FORNIX_OPENAI_TIMEOUT_SECONDS=30
# FORNIX_OPENAI_ALLOW_PRIVATE=false

# Federation polling is disabled unless explicitly enabled with a managed
# credential authority. The token value is never placed in this file; only
# the name of the process environment variable is configured.
FORNIX_FEDERATION_POLL_ENABLED=false
# Retention ownership is opt-in. When enabled, the server acquires one
# workspace-scoped Postgres fence at a time and expires only operational
# federation rows; authoritative history is never selected.
FORNIX_FEDERATION_RETENTION_ENABLED=false
FORNIX_FEDERATION_RETENTION_INTERVAL_SECONDS=3600
FORNIX_FEDERATION_RETENTION_BATCH_SIZE=100
FORNIX_FEDERATION_RETENTION_WORKSPACE_LIMIT=100
# FORNIX_CREDENTIAL_MANAGER_URL=https://credential-manager.example/v1/resolve
FORNIX_CREDENTIAL_MANAGER_TOKEN_REF=FORNIX_CREDENTIAL_MANAGER_TOKEN
# FORNIX_CREDENTIAL_MANAGER_TOKEN=inject-at-runtime-only
# FORNIX_CREDENTIAL_MANAGER_ALLOW_PRIVATE=false
# FORNIX_CREDENTIAL_MANAGER_TIMEOUT_SECONDS=10

# Optional deployment-owned PostgreSQL topology qualification. Keep the DSN
# out of files and logs; provide it only in the process environment when
# running `make qualification-postgres-topology`.
# FORNIX_TOPOLOGY_PG_DSN=postgres://USER:PASSWORD@HOST:PORT/DISPOSABLE_DATABASE?sslmode=require
# FORNIX_TOPOLOGY_OPERATIONS=32
# FORNIX_TOPOLOGY_WORKERS=4
# FORNIX_TOPOLOGY_POOL_MAX=4
# FORNIX_TOPOLOGY_REQUIRE_ARCHIVE=false
