# Local-only development values. Copy to .env; do not commit .env.
FORNIX_DB_NAME=fornix
FORNIX_DB_USER=fornix
FORNIX_DB_PASSWORD=fornix-dev-only
FORNIX_PG_PORT=55433

# Canonical Fornix runtime configuration.
# Development compatibility is intentionally explicit. Production should use
# FORNIX_AUTH_MODE=workspace and provision identities/API keys through the
# typed AuthStore or a future administrative CLI.
FORNIX_AUTH_MODE=development
FORNIX_WORKER_ENABLED=true
FORNIX_KEY=fornix-dev-only-change-me
# Required only for workspace bootstrap when using the operator CLI/API.
# Keep this in .env or the process environment; never commit or print it.
FORNIX_BOOTSTRAP_KEY=replace-with-a-local-bootstrap-secret
FORNIX_WORKSPACE_ID=default
FORNIX_PG_DSN=postgres://fornix:fornix-dev-only@localhost:55433/fornix?sslmode=disable
FORNIX_LISTEN=:8201
FORNIX_OLLAMA_URL=http://localhost:11434

# Optional remote chat provider. Disabled unless explicitly enabled. The
# credential value is supplied only in the local .env/environment and is
# never committed or placed in a model request.
FORNIX_OPENAI_ENABLED=false
# FORNIX_OPENAI_API_KEY=
# FORNIX_OPENAI_BASE_URL=https://api.openai.com/v1
# FORNIX_OPENAI_MODEL=gpt-4o-mini
# FORNIX_OPENAI_TIMEOUT_SECONDS=30
# FORNIX_OPENAI_ALLOW_PRIVATE=false
